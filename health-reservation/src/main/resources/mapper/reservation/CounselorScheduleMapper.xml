<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.reservation.mapper.CounselorScheduleMapper">

    <resultMap type="CounselorSchedule" id="CounselorScheduleResult">
        <result property="id"    column="id"    />
        <result property="counselorId"    column="counselor_id"    />
        <result property="scheduleDate"    column="schedule_date"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="slotDuration"    column="slot_duration"    />
        <result property="totalSlots"    column="total_slots"    />
        <result property="availableSlots"    column="available_slots"    />
        <result property="isAvailable"    column="is_available"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectCounselorScheduleVo">
        select id, counselor_id, schedule_date, start_time, end_time, slot_duration, total_slots, available_slots, is_available, create_by, create_time, update_by, update_time, remark from counselor_schedule
    </sql>

    <select id="selectCounselorScheduleList" parameterType="CounselorSchedule" resultMap="CounselorScheduleResult">
        <include refid="selectCounselorScheduleVo"/>
        <where>
            <if test="counselorId != null"> and counselor_id = #{counselorId}</if>
            <if test="scheduleDate != null"> and schedule_date = #{scheduleDate}</if>
            <if test="params.beginDate != null and params.beginDate != ''"><!-- 开始时间检索 -->
                and schedule_date &gt;= #{params.beginDate}
            </if>
            <if test="params.endDate != null and params.endDate != ''"><!-- 结束时间检索 -->
                and schedule_date &lt;= #{params.endDate}
            </if>
            <if test="isAvailable != null  and isAvailable != ''"> and is_available = #{isAvailable}</if>
        </where>
        order by schedule_date asc, start_time asc
    </select>

    <select id="selectCounselorScheduleById" parameterType="Long" resultMap="CounselorScheduleResult">
        <include refid="selectCounselorScheduleVo"/>
        where id = #{id}
    </select>

    <insert id="insertCounselorSchedule" parameterType="CounselorSchedule" useGeneratedKeys="true" keyProperty="id">
        insert into counselor_schedule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="counselorId != null">counselor_id,</if>
            <if test="scheduleDate != null">schedule_date,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="slotDuration != null">slot_duration,</if>
            <if test="totalSlots != null">total_slots,</if>
            <if test="availableSlots != null">available_slots,</if>
            <if test="isAvailable != null">is_available,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="counselorId != null">#{counselorId},</if>
            <if test="scheduleDate != null">#{scheduleDate},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="slotDuration != null">#{slotDuration},</if>
            <if test="totalSlots != null">#{totalSlots},</if>
            <if test="availableSlots != null">#{availableSlots},</if>
            <if test="isAvailable != null">#{isAvailable},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateCounselorSchedule" parameterType="CounselorSchedule">
        update counselor_schedule
        <trim prefix="SET" suffixOverrides=",">
            <if test="counselorId != null">counselor_id = #{counselorId},</if>
            <if test="scheduleDate != null">schedule_date = #{scheduleDate},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="slotDuration != null">slot_duration = #{slotDuration},</if>
            <if test="totalSlots != null">total_slots = #{totalSlots},</if>
            <if test="availableSlots != null">available_slots = #{availableSlots},</if>
            <if test="isAvailable != null">is_available = #{isAvailable},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCounselorScheduleById" parameterType="Long">
        delete from counselor_schedule where id = #{id}
    </delete>

    <delete id="deleteCounselorScheduleByIds" parameterType="String">
        delete from counselor_schedule where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
