<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.counseling.mapper.CounselingMapper">

    <resultMap type="Counselor" id="CounselorResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="realName"    column="real_name"    />
        <result property="avatar"    column="avatar"    />
        <result property="title"    column="title"    />
        <result property="specialties"    column="specialties"    />
        <result property="experienceYears"    column="experience_years"    />
        <result property="satisfactionRate"    column="satisfaction_rate"    />
        <result property="consultationCount"    column="consultation_count"    />
        <result property="bio"    column="bio"    />
        <result property="education"    column="education"    />
        <result property="hourlyRate"    column="hourly_rate"    />
        <result property="status"    column="status"    />
        <result property="isFeatured"    column="is_featured"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <resultMap type="Appointment" id="AppointmentResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="counselorId"    column="counselor_id"    />
        <result property="scheduleId"    column="schedule_id"    />
        <result property="appointmentTime"    column="appointment_time"    />
        <result property="durationMinutes"    column="duration_minutes"    />
        <result property="status"    column="status"    />
        <result property="consultationType"    column="consultation_type"    />
        <result property="notes"    column="notes"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCounselorVo">
        select id, user_id, real_name, avatar, title, specialties, experience_years, satisfaction_rate, consultation_count, bio, education, hourly_rate, status, is_featured, sort_order, create_time from counselor
    </sql>

    <select id="selectCounselorList" parameterType="Counselor" resultMap="CounselorResult">
        <include refid="selectCounselorVo"/>
        <where>
            <if test="realName != null and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="isFeatured != null and isFeatured != ''"> and is_featured = #{isFeatured}</if>
        </where>
        order by sort_order, id
    </select>

    <select id="selectCounselorById" parameterType="Long" resultMap="CounselorResult">
        <include refid="selectCounselorVo"/>
        where id = #{id}
    </select>

    <insert id="insertCounselor" parameterType="Counselor" useGeneratedKeys="true" keyProperty="id">
        insert into counselor
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="realName != null">real_name,</if>
            <if test="avatar != null">avatar,</if>
            <if test="title != null">title,</if>
            <if test="specialties != null">specialties,</if>
            <if test="experienceYears != null">experience_years,</if>
            <if test="satisfactionRate != null">satisfaction_rate,</if>
            <if test="consultationCount != null">consultation_count,</if>
            <if test="bio != null">bio,</if>
            <if test="education != null">education,</if>
            <if test="hourlyRate != null">hourly_rate,</if>
            <if test="status != null">status,</if>
            <if test="isFeatured != null">is_featured,</if>
            <if test="sortOrder != null">sort_order,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="realName != null">#{realName},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="title != null">#{title},</if>
            <if test="specialties != null">#{specialties},</if>
            <if test="experienceYears != null">#{experienceYears},</if>
            <if test="satisfactionRate != null">#{satisfactionRate},</if>
            <if test="consultationCount != null">#{consultationCount},</if>
            <if test="bio != null">#{bio},</if>
            <if test="education != null">#{education},</if>
            <if test="hourlyRate != null">#{hourlyRate},</if>
            <if test="status != null">#{status},</if>
            <if test="isFeatured != null">#{isFeatured},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
        </trim>
    </insert>

    <update id="updateCounselor" parameterType="Counselor">
        update counselor
        <trim prefix="SET" suffixOverrides=",">
            <if test="realName != null">real_name = #{realName},</if>
            <if test="title != null">title = #{title},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isFeatured != null">is_featured = #{isFeatured},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCounselorById" parameterType="Long">
        delete from counselor where id = #{id}
    </delete>

    <delete id="deleteCounselorByIds" parameterType="Long">
        delete from counselor where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <!-- Appointment -->
    <sql id="selectAppointmentVo">
        select id, user_id, counselor_id, schedule_id, appointment_time, duration_minutes, status, consultation_type, notes, create_time, update_time from appointment
    </sql>

    <select id="selectAppointmentList" parameterType="Appointment" resultMap="AppointmentResult">
        <include refid="selectAppointmentVo"/>
        <where>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="counselorId != null"> and counselor_id = #{counselorId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by appointment_time desc
    </select>

    <select id="selectAppointmentById" parameterType="Long" resultMap="AppointmentResult">
        <include refid="selectAppointmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertAppointment" parameterType="Appointment" useGeneratedKeys="true" keyProperty="id">
        insert into appointment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="counselorId != null">counselor_id,</if>
            <if test="scheduleId != null">schedule_id,</if>
            <if test="appointmentTime != null">appointment_time,</if>
            <if test="durationMinutes != null">duration_minutes,</if>
            <if test="status != null">status,</if>
            <if test="consultationType != null">consultation_type,</if>
            <if test="notes != null">notes,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="counselorId != null">#{counselorId},</if>
            <if test="scheduleId != null">#{scheduleId},</if>
            <if test="appointmentTime != null">#{appointmentTime},</if>
            <if test="durationMinutes != null">#{durationMinutes},</if>
            <if test="status != null">#{status},</if>
            <if test="consultationType != null">#{consultationType},</if>
            <if test="notes != null">#{notes},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateAppointment" parameterType="Appointment">
        update appointment
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="notes != null">notes = #{notes},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppointmentById" parameterType="Long">
        delete from appointment where id = #{id}
    </delete>

    <delete id="deleteAppointmentByIds" parameterType="Long">
        delete from appointment where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
